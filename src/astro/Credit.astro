---
/* The footer credit, and optionally the character standing on it.
   ---------------------------------------------------------------------------
   `creditsFor()` has emitted the fleet's credit from one place since 0.23.0,
   which is the property this component is built on rather than around: the
   sentence, the anchor and the JSON-LD are unchanged and still come from
   `../credits/index.ts`. What is new is one optional element beside them and a
   script that mounts an anchored companion on it.

   **A component rather than a hook attribute plus a per-site import line.**
   The alternative was `creditsFor()` gaining a `data-` hook and each footer
   adding its own `<script>` — which works, and makes every later improvement
   to the mount four commits in four repos. Here a site's whole adoption is one
   import and one element, and the next change to any of this is a version bump
   with no site commit at all. It is available because every site in the fleet
   is Astro, which §8.1 measured rather than assumed.

   **Astro hashes this file's own `<script>` and `<style>` into the adopting
   site's CSP.** That is the same mechanism `edit.astro` relies on and the
   reason the component can carry both without any site having to learn a hash
   or loosen a directive.

   **A bump alone changes nothing.** Without `companion` this renders exactly
   what `creditsFor()` returns and nothing else — same string, same function —
   so the release is safe to take on the sites that have not looked at this
   yet, and the character arrives only where somebody wrote the word. Session
   26's leaderboard shipped answering `{ configured: false }` for the same
   reason.

   Two rulings in `../credits/index.ts` survive here and are worth restating
   because this is where somebody would break them:

   - **The anchor opens in a new tab.** A visitor who taps a footer credit has
     not decided to leave, and taking them off a client's site is a cost the
     client pays for our benefit. That holds for the sentence the companion
     says as much as for the credit itself, which is why the offer below is
     given a `target` and a `rel` rather than a bare href.
   - **`noreferrer` is deliberately absent.** The referrer is how we learn
     which client's site sent somebody. Do not add it while improving a link. */

import { creditHref, creditLine, creditsFor, creditsJsonLd } from "@shaahink/sitekit/credits";
import type { CreditLineOptions } from "@shaahink/sitekit/credits";

export interface Props extends CreditLineOptions {
  /** Bring the character. Absent on every site until its owner has seen one. */
  companion?: boolean | undefined;
  /** **Which end of the credit he stands at**, and it is spelled logically
      because half the fleet reads right to left: `"end"` puts him after the
      sentence, which is the physical right of an English footer and the
      physical left of a Farsi one.

      It is a prop rather than a constant because the two ends are not
      interchangeable on a real footer — a credit that already sits hard against
      the inline-end edge of its container has no room on that side, and the
      site is the only thing that knows. It decides *markup order* and nothing
      else: the yard below is an ordinary inline box, so putting it before the
      sentence is the whole of standing him at the other end. */
  side?: "start" | "end" | undefined;
  /** **His one line, and it is content.** A studio's offer in a client's
      footer is copy somebody has to approve, so it is a prop with a default
      rather than a constant in a script — a site that wants different words
      writes them, and nobody edits the kit to change a sentence.

      The register is the fleet's own: the offer made once, and then quiet.

      **`say=""` is a supported value, and it is not the same as no companion.**
      He mounts, stands on the credit and says nothing. That is the state a site
      is in while its owner is looking at the character and has not yet approved
      the words — which is a real state and was an unreachable one until 0.27.0,
      because the script below treated an empty string as "no mount" and the
      only way to see him was to ship the sentence with him. `companion` decides
      whether he is there; this decides whether he speaks. */
  say?: string | undefined;
}

const {
  companion = false,
  side = "end",
  say = "He made this one. Want one?",
  ...credit
} = Astro.props;

/* The visible sentence, and the machine-readable claim under it. Split only on
   the companion path, so the ordinary one is the single call every footer in
   the fleet already makes and cannot drift from it. */
const line = companion ? creditLine(credit) : creditsFor(credit);

/* Where the offer points: the same href the credit does, through the same
   resolver, so the sentence and the name under it cannot disagree about which
   site they mean — including on the sites that pass no `href` at all and take
   the studio's own. */
const href = creditHref(credit);
---

{
  companion ? (
    <span class="sk-credit-walk">
      {side === "start" && <span class="sk-credit-yard sk-credit-yard--start">
        <span class="sk-credit-mate" data-sk-credit-mate data-sk-say={say} data-sk-to={href} />
      </span>}
      <Fragment set:html={line} />
      {/* The yard is empty and stays empty until the browser is idle:
          everything inside it is built by the deferred chunk into a shadow
          root, so a reader who never reaches the footer, who asked for reduced
          motion, or whose network dropped the chunk gets the credit exactly as
          it is without him — and, because the yard's width is declared in CSS
          rather than discovered when he arrives, gets it at the same width
          too. No `aria-hidden` here: the figure sets its own, and hiding the
          host would silence the one line that is announced. */}
      {side === "end" && <span class="sk-credit-yard sk-credit-yard--end">
        <span class="sk-credit-mate" data-sk-credit-mate data-sk-say={say} data-sk-to={href} />
      </span>}
      <Fragment set:html={creditsJsonLd(credit)} />
    </span>
  ) : (
    <Fragment set:html={line} />
  )
}

<style>
  /* **He stands beside the credit, not on it, and the yard is what changed.**
     ---------------------------------------------------------------------------
     Until 0.28.0 the mount resolved against `.sk-credit-walk` — the box around
     the sentence itself — which made the credit his floor in the literal sense:
     `inset-block-end: calc(100% - …)` stood him on that box's *top* edge, so he
     was drawn in the band directly above the words, pacing across 14%–80% of
     their width. On a footer that is a figure hovering over *{sk} made this*
     with whatever sits above the footer behind him, and it was the owner's
     report: not quite right on top of the credit, put him to one side.

     So he is given a yard: an ordinary empty inline box **beside** the
     sentence, and the mount resolves against that instead. Four properties do
     the whole of it and each is load-bearing.

     `position: relative` makes the yard — rather than the credit — the nearest
     positioned ancestor, which is what the kit's `anchor` placement means by
     *the host's own containing block*. That sentence was in `companion.ts`
     before this component existed and was not true of it; it is now.

     `block-size: 0` is the trick and it is worth spelling out. The mount stands
     on its containing block's block-start edge, and a box with no height has
     that edge in the same place as its block-end one — so a zero-height yard
     puts his feet exactly on its bottom margin edge. An empty inline-block's
     baseline *is* its bottom margin edge, so that bottom edge is the text
     baseline of the credit line: he stands on the same floor the words stand
     on, at the same size relative to them, and the line box is not one pixel
     taller for his being there. The drop he arrives with still works unchanged
     — it is a negative offset from that floor and he falls onto it.

     `inline-size` is the room, and it is declared here rather than measured
     because a width that arrived with the deferred chunk would reflow somebody's
     footer at idle. `3.4em` is `--sk-mate-h`, the height the kit draws an
     anchored companion at; `0.8333` is his aspect — the figure's viewBox is 60
     wide by 72 tall — and it is a *fallback*, so a site that hands the kit a
     rig of its own gets that rig's real aspect the moment the shadow root sets
     the property and the yard resizes to match.

     **The 1.5 is a bound rather than a taste**, and it is the same number as
     `ANCHOR_PACE`'s walk band. He is placed by his centre and drawn either side
     of it, so keeping his box inside a yard of `k` widths needs the band to
     start no earlier than `1 / 2k`: at `k = 1.5` that is a third, which is
     exactly what `walkMin` and `walkMax` are set to. Widen one without the
     other and he paces out of his yard and back over the words — which is the
     bug this whole file is fixing, so the two numbers are commented in both
     places.

     `.sk-credit-walk` is no longer positioned and no longer an inline-block.
     Both existed only to be his containing block, and an inline-block credit
     cannot break across two lines the way an inline one can — so dropping them
     takes a constraint off the client footers rather than adding one.

     Nothing else. No colour, no size, no font: he is drawn in `currentColor`
     and measured in `em` off this line, so a client's own footer styling is
     the whole of his palette and his scale. */
  .sk-credit-yard {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    block-size: 0;
    inline-size: calc(var(--sk-mate-h, 3.4em) * var(--sk-mate-aspect, 0.8333) * 1.5);
  }

  /* The daylight between him and the sentence, on whichever side he is. A
     margin rather than padding on the yard, because padding would be inside the
     box his percentage insets are resolved against and would put the two
     numbers above out by the width of the gap. */
  .sk-credit-yard--end {
    margin-inline-start: 0.3em;
  }
  .sk-credit-yard--start {
    margin-inline-end: 0.3em;
  }
</style>

<script>
  /* **`mountMotion` is the only static import, and that is the byte budget.**
     Rule 1 of `motion/boot.ts`: `start` is not called — and therefore whatever
     it dynamically imports is not fetched — until `load` has fired and the
     browser has reported itself idle. So the figure, the rig, the lines and
     every frame of behaviour arrive after first idle, and a client page's
     transferred bytes before it are the boot contract and nothing else.
     Importing `companionAt` at the top of this file would have compiled,
     worked, looked identical in a browser, and put the whole module on the
     critical path of every page of somebody's site.

     `companionAt` rather than `mountCompanion` because the waiting has already
     happened here; see its own comment for what the doubled version costs. */
  import { mountMotion } from "@shaahink/sitekit/motion";

  for (const host of document.querySelectorAll<HTMLElement>("[data-sk-credit-mate]")) {
    const say = host.dataset.skSay ?? "";
    const to = host.dataset.skTo ?? "";

    mountMotion(host, async () => {
      const { companionAt } = await import("@shaahink/sitekit/companion");
      return companionAt(host, {
        /* One line, at the host's own stage — in `anchor` placement the stage
           list is the host itself and its key is its `id`, which is the empty
           string on an element that has none. Reading it off the element
           rather than writing `""` here keeps that true if a site ever gives
           the mount an id.

           `ANCHOR_PACE` does the rest: cap one, gap two minutes, no landing
           asides, and `askAfter: 0` because the offer is the only thing he has
           to say. A new tab and `author noopener`, for the reason at the top of
           this file.

           **An empty `say` is an empty script, not a skipped mount**, and the
           difference is the whole of what a site owner is shown while he
           decides on the words. `companionAt` draws the figure off `rig` and
           reads `lines` only for what comes out of his mouth, so the empty
           array is a character standing on the credit in silence — the same
           state `draw()` already puts him in on a stage whose lines are used
           up, and it makes no new one. Presence is `companion`, one element
           up: no element, no loop, no chunk. */
        lines: say
          ? [
              {
                at: host.id,
                text: say,
                ask: to ? { href: to, target: "_blank", rel: "author noopener" } : null
              }
            ]
          : []
      });
    });
  }
</script>
