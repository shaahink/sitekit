{
  "name": "@shaahink/sitekit",
  "version": "0.6.0",
  "description": "Shared logic for the sk site fleet: feedback intake, screenshot proxy, widget internals, credits, the dual header emitter, site URLs and sitemaps from one source, the analytics tag, and the owner's editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaahink/sitekit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "sitekit-editor-css": "./bin/editor-css.mjs"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./shot": {
      "types": "./dist/shot/index.d.ts",
      "default": "./dist/shot/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "default": "./dist/widget/index.js"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "default": "./dist/credits/index.js"
    },
    "./headers": {
      "types": "./dist/headers/index.d.ts",
      "default": "./dist/headers/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "default": "./dist/seo/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    },
    "./cms": {
      "types": "./dist/cms/index.d.ts",
      "default": "./dist/cms/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./editor/editor.css": "./dist/editor/editor.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.server.json && tsc -p tsconfig.widget.json && tsc -p tsconfig.editor.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
