{
  "name": "@shaahink/sitekit",
  "version": "0.16.1",
  "description": "Shared logic for the sk site fleet: feedback intake, screenshot proxy, widget internals, credits, the dual header emitter, site URLs and sitemaps from one source, the analytics tag and its stats reader, and the owner's editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaahink/sitekit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "sitekit-editor-css": "./bin/editor-css.mjs",
    "sitekit-headers": "./bin/headers.mjs",
    "sitekit-normalize": "./bin/normalize.mjs"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./shot": {
      "types": "./dist/shot/index.d.ts",
      "default": "./dist/shot/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "default": "./dist/widget/index.js"
    },
    "./widget/chrome": {
      "types": "./dist/widget/chrome.d.ts",
      "default": "./dist/widget/chrome.js"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "default": "./dist/credits/index.js"
    },
    "./headers": {
      "types": "./dist/headers/index.d.ts",
      "default": "./dist/headers/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "default": "./dist/seo/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    },
    "./stats": {
      "types": "./dist/analytics/stats.d.ts",
      "default": "./dist/analytics/stats.js"
    },
    "./cms": {
      "types": "./dist/cms/index.d.ts",
      "default": "./dist/cms/index.js"
    },
    "./visibility": {
      "types": "./dist/cms/visibility.d.ts",
      "default": "./dist/cms/visibility.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./editor/inline": {
      "types": "./dist/editor/inline.d.ts",
      "default": "./dist/editor/inline.js"
    },
    "./editor/inline-gate": {
      "types": "./dist/editor/inline-gate.d.ts",
      "default": "./dist/editor/inline-gate.js"
    },
    "./editor/editor.css": "./dist/editor/editor.css",
    "./editor/inline.css": "./dist/editor/inline.css",
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./astro/edit.astro": "./dist/astro/edit.astro",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.server.json && tsc -p tsconfig.widget.json && tsc -p tsconfig.editor.json && tsc -p tsconfig.astro.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "proof": "node scripts/prove.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "astro": "^7",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
