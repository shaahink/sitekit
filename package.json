{
  "name": "@shaahink/sitekit",
  "version": "0.2.0",
  "description": "Shared logic for the sk site fleet: feedback intake, screenshot proxy, widget internals, credits, and the dual header emitter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaahink/sitekit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./shot": {
      "types": "./dist/shot/index.d.ts",
      "default": "./dist/shot/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "default": "./dist/widget/index.js"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "default": "./dist/credits/index.js"
    },
    "./headers": {
      "types": "./dist/headers/index.d.ts",
      "default": "./dist/headers/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.widget.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
